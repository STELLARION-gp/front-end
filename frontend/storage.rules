// Firebase Storage Security Rules
// Add these rules to your Firebase Console -> Storage -> Rules

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Blog images
    match /blog-images/{blogId}/{filename} {
      // Allow anyone to read blog images
      allow read: if true;
      
      // Only authenticated users can upload/write blog images
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024 // 5MB limit
                   && request.resource.contentType.matches('image/.*'); // Only images
      
      // Only the uploader or admin can delete
      allow delete: if request.auth != null;
    }
    
    // Temporary uploads folder
    match /blog-images/temp/{filename} {
      allow read, write, delete: if request.auth != null
                                 && request.resource.size < 5 * 1024 * 1024
                                 && request.resource.contentType.matches('image/.*');
    }
  }
}
