# Chatbot Environment Configuration

# Add these environment variables to your .env file to enable API-based responses

# Provider options: 'openai', 'cohere', 'huggingface', 'custom', or leave empty for rule-based responses
VITE_CHATBOT_PROVIDER=

# API Key for the chosen provider (if required)
VITE_CHATBOT_API_KEY=

# Examples for different providers:

# For OpenAI (paid service)
# VITE_CHATBOT_PROVIDER=openai
# VITE_CHATBOT_API_KEY=your_openai_api_key_here

# For Cohere (free tier available)
# VITE_CHATBOT_PROVIDER=cohere
# VITE_CHATBOT_API_KEY=your_cohere_api_key_here

# For Hugging Face (free tier available)
# VITE_CHATBOT_PROVIDER=huggingface
# VITE_CHATBOT_API_KEY=your_huggingface_api_key_here

# For custom backend
# VITE_CHATBOT_PROVIDER=custom
# VITE_CHATBOT_API_KEY=your_custom_api_key_here
